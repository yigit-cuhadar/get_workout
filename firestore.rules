rules_version = '2';

// Expected results. There is no emulator here, so check changes against this.
//
//   Path                     Who                                    Read  Write
//   exercises/{id}           signed out                             deny  deny
//   exercises/{id}           any signed-in user, guests included    allow deny
//   exercises/{id}           admin claim                            allow allow
//   programs/{id}            signed out                             deny  deny
//   programs/{id}            any signed-in user, guests included    allow deny
//   programs/{id}            admin claim                            allow allow
//   programs/{id}/detail/x   signed out                             deny  deny
//   programs/{id}/detail/x   signed in, program premium absent      allow deny
//                            or exactly false
//   programs/{id}/detail/x   signed in, program premium any other   deny  deny
//                            value (true, null, "false", 0, ...),
//                            entitlement absent / premium not true
//                            / expiresAt missing or <= now
//   programs/{id}/detail/x   signed in, program premium any other   allow deny
//                            value, entitlement premium true and
//                            expiresAt > now
//   programs/{id}/detail/x   signed in, program does not exist,     deny  deny
//                            no active entitlement
//   programs/{id}/detail/x   admin claim, any program               allow allow
//   entitlements/{uid}       owner                                  allow deny
//   entitlements/{uid}       anyone else, admins included           deny  deny
//   entitlements/{uid}       any client create/update/delete,       -     deny
//                            whatever the fields (only the
//                            revenueCatWebhook and deleteAccount
//                            functions write, through the Admin SDK)
//   announcements/{id}       admin claim                            allow deny
//   announcements/{id}       anyone else                            deny  deny
//   users/{uid}/**           owner                                  allow allow
//   users/{uid}/**           anyone else                            deny  deny
//   anything else            anyone                                 deny  deny
//
// Firestore ORs every matching `allow`, so a path a validating rule guards
// must not also match a broader rule that allows it.
//
// users/{uid}/cardio/{id}, as the signed-in user `uid` (anyone else: deny):
// | Request                                                        | Result |
// |----------------------------------------------------------------|--------|
// | read, list, delete own session                                 | allow  |
// | create/update: type string, date timestamp, durationS 1-86400  | allow  |
// | ... plus numeric distanceKm/calories/avgHeartRate/incline      | allow  |
// | ... plus note string of at most 500 characters                 | allow  |
// | ... plus fields the app does not know (kept by edits)          | allow  |
// | missing type, date or durationS                                | deny   |
// | type not a string, date not a timestamp                        | deny   |
// | durationS 0, negative, above 86400 or not a number             | deny   |
// | an optional number field holding a string or other non-number  | deny   |
// | note not a string, or longer than 500 characters               | deny   |
// | any request for another user's sessions, or signed out         | deny   |
//
// users/{uid}/bodyEntries/{id}, as the signed-in user `uid` (anyone else: deny):
// | Request                                                        | Result |
// |----------------------------------------------------------------|--------|
// | read, list, delete own entry                                   | allow  |
// | create/update: date timestamp                                  | allow  |
// | ... plus numeric weightKg, measurements map, photos map        | allow  |
// | ... plus keys the app does not know in either map              | allow  |
// | ... plus fields the app does not know (kept by edits)          | allow  |
// | missing date, or date not a timestamp                          | deny   |
// | weightKg not a number, measurements or photos not a map        | deny   |
// | a known measurement not a number, a known pose not a string    | deny   |
// | any request for another user's entries, or signed out          | deny   |
//
// users/{uid}/programs/{id}, as the signed-in user `uid` (anyone else: deny):
// | Request                                                        | Result |
// |----------------------------------------------------------------|--------|
// | read, list, delete own program                                 | allow  |
// | create/update: name string of 1-60 characters, days a list of  | allow  |
// | 1-7 entries, origin "own", "catalog" or "generated"            |        |
// | ... plus premium true or false                                 | allow  |
// | ... plus fields the app does not know (kept by edits)          | allow  |
// | missing name, days or origin                                   | deny   |
// | premium not a boolean                                          | deny   |
// | name empty, longer than 60 characters or not a string          | deny   |
// | days empty, more than 7 entries or not a list                  | deny   |
// | origin any other value                                         | deny   |
// | any request for another user's programs, or signed out         | deny   |
//
// users/{uid}/workouts/{id}, as the signed-in user `uid` (anyone else: deny):
// | Request                                                        | Result |
// |----------------------------------------------------------------|--------|
// | read, list, delete own workout                                 | allow  |
// | create/update: startedAt and finishedAt timestamps, finishedAt | allow  |
// | not before startedAt, name string of 1-100 characters,         |        |
// | exercises and exerciseIds lists of 1-40 entries                |        |
// | ... plus programId string, dayIndex int 0-6, note string of at | allow  |
// | most 1000 characters                                           |        |
// | missing startedAt, finishedAt, name, exercises or exerciseIds  | deny   |
// | finishedAt before startedAt, either not a timestamp            | deny   |
// | name empty, longer than 100 characters or not a string         | deny   |
// | exercises or exerciseIds empty, above 40 entries or not a list | deny   |
// | programId not a string, dayIndex not an int or outside 0-6     | deny   |
// | note not a string, or longer than 1000 characters              | deny   |
// | any other field                                                | deny   |
// | any request for another user's workouts, or signed out         | deny   |
//
// users/{uid}/exerciseStats/{exerciseId}, as the signed-in user `uid`
// (anyone else: deny):
// | Request                                                        | Result |
// |----------------------------------------------------------------|--------|
// | read, list, delete own stats                                   | allow  |
// | create/update: records map, history list of at most 1000       | allow  |
// | points, optional last map                                      |        |
// | records with a key other than heaviestWeight, bestE1rm,        | deny   |
// | bestSetVolume, mostReps or longestDuration                     |        |
// | records not a map, last not a map, history not a list or above | deny   |
// | 1000 points, or missing records or history                     |        |
// | any other field                                                | deny   |
// | any request for another user's stats, or signed out            | deny   |

// users/{uid}/customExercises/{id}, as the signed-in user `uid` (anyone
// else: deny). The 500-per-user limit is the app's; rules cannot count.
// | Request                                                        | Result |
// |----------------------------------------------------------------|--------|
// | read, list, delete own custom exercise                         | allow  |
// | create/update, id custom_ + 20 letters or digits: name string  | allow  |
// | 1-60, known loggingType, 1+ known mainMuscles, known           |        |
// | secondaryMuscles and equipment lists (may be empty)            |        |
// | ... plus note string of 1-500 characters                       | allow  |
// | id without the custom_ prefix or not an auto id                | deny   |
// | a field missing (note excepted) or any other field             | deny   |
// | name empty, longer than 60 or not a string                     | deny   |
// | unknown loggingType, muscle or equipment code                  | deny   |
// | no main muscle; a muscle twice, or both main and secondary     | deny   |
// | equipment twice, or bodyweight with anything else              | deny   |
// | note empty, longer than 500 or not a string                    | deny   |
// | any request for another user's custom exercises, or signed out | deny   |
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.get('admin', false) == true;
    }

    // Fails closed: only an absent or exactly false premium is free.
    function isFree(program) {
      return !('premium' in program.data) || program.data.premium == false;
    }

    function hasEntitlement() {
      let path = /databases/$(database)/documents/entitlements/$(request.auth.uid);
      return exists(path)
        && get(path).data.get('premium', false) == true
        && get(path).data.expiresAt > request.time;
    }

    // Deny by default. Each feature adds the narrowest rule it needs.
    match /{document=**} {
      allow read, write: if false;
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function optionalNumber(data, field) {
      return !(field in data) || data[field] is number;
    }

    function isCardio(data) {
      return data.type is string
        && data.date is timestamp
        && data.durationS is number
        && data.durationS > 0
        && data.durationS <= 86400
        && optionalNumber(data, 'distanceKm')
        && optionalNumber(data, 'calories')
        && optionalNumber(data, 'avgHeartRate')
        && optionalNumber(data, 'incline')
        && (!('note' in data) || (data.note is string && data.note.size() <= 500));
    }

    function optionalString(data, field) {
      return !(field in data) || data[field] is string;
    }

    // Rules cannot loop, so the known keys are checked one by one; keys of
    // a newer app version pass.
    function isMeasurements(m) {
      return m is map
        && optionalNumber(m, 'neck') && optionalNumber(m, 'shoulders')
        && optionalNumber(m, 'chest') && optionalNumber(m, 'waist')
        && optionalNumber(m, 'abdomen') && optionalNumber(m, 'hips')
        && optionalNumber(m, 'leftUpperArm') && optionalNumber(m, 'rightUpperArm')
        && optionalNumber(m, 'leftForearm') && optionalNumber(m, 'rightForearm')
        && optionalNumber(m, 'leftThigh') && optionalNumber(m, 'rightThigh')
        && optionalNumber(m, 'leftCalf') && optionalNumber(m, 'rightCalf');
    }

    function isPhotos(p) {
      return p is map
        && optionalString(p, 'front') && optionalString(p, 'right')
        && optionalString(p, 'left') && optionalString(p, 'back');
    }

    function isBodyEntry(data) {
      return data.date is timestamp
        && optionalNumber(data, 'weightKg')
        && (!('measurements' in data) || isMeasurements(data.measurements))
        && (!('photos' in data) || isPhotos(data.photos));
    }

    // Updates write only name, length, days and updatedAt; origin stays as
    // stored and is checked on the result.
    function isProgram(data) {
      return data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 60
        && data.days is list
        && data.days.size() >= 1
        && data.days.size() <= 7
        && data.origin in ['own', 'catalog', 'generated']
        && (!('premium' in data) || data.premium is bool);
    }

    // Exercises are checked by the app; a document stays under 1 MB at
    // 40 exercises of 30 sets.
    function isWorkout(data) {
      return data.keys().hasOnly([
          'startedAt', 'finishedAt', 'programId', 'dayIndex', 'name', 'note',
          'exerciseIds', 'exercises'])
        && data.startedAt is timestamp
        && data.finishedAt is timestamp
        && data.finishedAt >= data.startedAt
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 100
        && data.exercises is list
        && data.exercises.size() >= 1
        && data.exercises.size() <= 40
        && data.exerciseIds is list
        && data.exerciseIds.size() >= 1
        && data.exerciseIds.size() <= 40
        && (!('programId' in data) || data.programId is string)
        && (!('dayIndex' in data)
          || (data.dayIndex is int && data.dayIndex >= 0 && data.dayIndex <= 6))
        && (!('note' in data) || (data.note is string && data.note.size() <= 1000));
    }

    function isExerciseStats(data) {
      return data.keys().hasOnly(['records', 'last', 'history'])
        && data.records is map
        && data.records.keys().hasOnly([
          'heaviestWeight', 'bestE1rm', 'bestSetVolume', 'mostReps',
          'longestDuration'])
        && (!('last' in data) || data.last is map)
        && data.history is list
        && data.history.size() <= 1000;
    }

    // SPEC.md, "Vocabulary"; keep in step with lib/.../vocabulary.dart.
    function loggingTypes() {
      return ['reps', 'weight_reps', 'weighted_bodyweight',
        'assisted_bodyweight', 'duration', 'weight_duration'];
    }

    function muscles() {
      return ['pec', 'lat', 'trap', 'front_delt', 'mid_delt', 'rear_delt',
        'biceps', 'triceps', 'forearm', 'abdominal', 'oblique', 'erector',
        'glute', 'hip_flexor', 'abductor', 'adductor', 'quads', 'hamstring',
        'calf'];
    }

    function equipmentCodes() {
      return ['barbell', 'ez_bar', 'trap_bar', 'dumbbell', 'kettlebell',
        'plate', 'cable', 'machine', 'smith_machine', 'bench', 'box',
        'back_extension_bench', 'pull_up_bar', 'dip_station',
        'resistance_band', 'suspension_trainer', 'rings', 'medicine_ball',
        'stability_ball', 'ab_wheel', 'landmine', 'sled', 'jump_rope',
        'bodyweight', 'other'];
    }

    function isCodeList(value, codes) {
      return value is list
        && value.hasOnly(codes)
        && value.toSet().size() == value.size();
    }

    // Mirrors validateCustomExercise in lib/features/exercises/domain.
    function isCustomExercise(id, data) {
      return id.matches('custom_[A-Za-z0-9]{20}')
        && data.keys().hasAll(['name', 'loggingType', 'mainMuscles',
          'secondaryMuscles', 'equipment'])
        && data.keys().hasOnly(['name', 'loggingType', 'mainMuscles',
          'secondaryMuscles', 'equipment', 'note'])
        && data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 60
        && data.loggingType in loggingTypes()
        && isCodeList(data.mainMuscles, muscles())
        && data.mainMuscles.size() >= 1
        && isCodeList(data.secondaryMuscles, muscles())
        && !data.mainMuscles.hasAny(data.secondaryMuscles)
        && isCodeList(data.equipment, equipmentCodes())
        && (!('bodyweight' in data.equipment) || data.equipment.size() == 1)
        && (!('note' in data)
          || (data.note is string && data.note.size() >= 1 && data.note.size() <= 500));
    }

    // A user's own data, guest or not.
    match /users/{uid} {
      allow read, write: if isOwner(uid);

      // Validated; only reachable here, the rule below excludes it.
      match /cardio/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && isCardio(request.resource.data);
      }

      // Validated; only reachable here, the rule below excludes it.
      match /bodyEntries/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && isBodyEntry(request.resource.data);
      }

      // Validated; only reachable here, the rule below excludes it.
      match /programs/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && isProgram(request.resource.data);
      }

      // Validated; only reachable here, the rule below excludes it.
      match /workouts/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && isWorkout(request.resource.data);
      }

      // Validated; only reachable here, the rule below excludes it.
      match /exerciseStats/{exerciseId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && isExerciseStats(request.resource.data);
      }

      // Validated; only reachable here, the rule below excludes it.
      match /customExercises/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && isCustomExercise(id, request.resource.data);
      }

      // Every other subcollection, at any depth, as before.
      match /{collection}/{document=**} {
        allow read, write: if isOwner(uid)
          && !(collection in ['cardio', 'bodyEntries', 'programs', 'workouts', 'exerciseStats', 'customExercises']);
      }
    }

    match /exercises/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /programs/{programId} {
      allow read: if signedIn();
      allow write: if isAdmin();

      match /detail/{doc} {
        allow read: if isAdmin()
          || (signedIn()
            && (isFree(get(/databases/$(database)/documents/programs/$(programId)))
              || hasEntitlement()));
        allow write: if isAdmin();
      }
    }

    // Written only by the revenueCatWebhook function (deleted by
    // deleteAccount) through the Admin SDK: `premium` (bool), `expiresAt`
    // (timestamp), `productId` and the webhook's own `lastEventMs` and
    // `lastEventId`. Rules read only `premium` and `expiresAt`
    // (hasEntitlement); a revoked entitlement keeps the document with
    // `premium` false so older events cannot grant it again.
    match /entitlements/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
    }

    // The history of sent announcements, written only by the
    // sendAnnouncement function through the Admin SDK.
    match /announcements/{id} {
      allow read: if isAdmin();
    }
  }
}
