rules_version = '2';

// Expected results. There is no emulator here, so check changes against this.
//
//   Path                     Who                                    Read  Write
//   exercises/{id}           signed out                             deny  deny
//   exercises/{id}           any signed-in user, guests included    allow deny
//   exercises/{id}           admin claim                            allow allow
//   programs/{id}            signed out                             deny  deny
//   programs/{id}            any signed-in user, guests included    allow deny
//   programs/{id}            admin claim                            allow allow
//   programs/{id}/detail/x   signed out                             deny  deny
//   programs/{id}/detail/x   signed in, program premium absent      allow deny
//                            or exactly false
//   programs/{id}/detail/x   signed in, program premium any other   deny  deny
//                            value (true, null, "false", 0, ...),
//                            entitlement absent / premium not true
//                            / expiresAt missing or <= now
//   programs/{id}/detail/x   signed in, program premium any other   allow deny
//                            value, entitlement premium true and
//                            expiresAt > now
//   programs/{id}/detail/x   signed in, program does not exist,     deny  deny
//                            no active entitlement
//   programs/{id}/detail/x   admin claim, any program               allow allow
//   entitlements/{uid}       owner                                  allow deny
//   entitlements/{uid}       anyone else, admins included           deny  deny
//   users/{uid}/**           owner                                  allow allow
//   users/{uid}/**           anyone else                            deny  deny
//   anything else            anyone                                 deny  deny
//
// Firestore ORs every matching `allow`, so a path a validating rule guards
// must not also match a broader rule that allows it.
//
// users/{uid}/cardio/{id}, as the signed-in user `uid` (anyone else: deny):
// | Request                                                        | Result |
// |----------------------------------------------------------------|--------|
// | read, list, delete own session                                 | allow  |
// | create/update: type string, date timestamp, durationS 1-86400  | allow  |
// | ... plus numeric distanceKm/calories/avgHeartRate/incline      | allow  |
// | ... plus note string of at most 500 characters                 | allow  |
// | ... plus fields the app does not know (kept by edits)          | allow  |
// | missing type, date or durationS                                | deny   |
// | type not a string, date not a timestamp                        | deny   |
// | durationS 0, negative, above 86400 or not a number             | deny   |
// | an optional number field holding a string or other non-number  | deny   |
// | note not a string, or longer than 500 characters               | deny   |
// | any request for another user's sessions, or signed out         | deny   |
//
// users/{uid}/programs/{id}, as the signed-in user `uid` (anyone else: deny):
// | Request                                                        | Result |
// |----------------------------------------------------------------|--------|
// | read, list, delete own program                                 | allow  |
// | create/update: name string of 1-60 characters, days a list of  | allow  |
// | 1-7 entries, origin "own", "catalog" or "generated"            |        |
// | ... plus fields the app does not know (kept by edits)          | allow  |
// | missing name, days or origin                                   | deny   |
// | name empty, longer than 60 characters or not a string          | deny   |
// | days empty, more than 7 entries or not a list                  | deny   |
// | origin any other value                                         | deny   |
// | any request for another user's programs, or signed out         | deny   |
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.get('admin', false) == true;
    }

    // Fails closed: only an absent or exactly false premium is free.
    function isFree(program) {
      return !('premium' in program.data) || program.data.premium == false;
    }

    function hasEntitlement() {
      let path = /databases/$(database)/documents/entitlements/$(request.auth.uid);
      return exists(path)
        && get(path).data.get('premium', false) == true
        && get(path).data.expiresAt > request.time;
    }

    // Deny by default. Each feature adds the narrowest rule it needs.
    match /{document=**} {
      allow read, write: if false;
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function optionalNumber(data, field) {
      return !(field in data) || data[field] is number;
    }

    function isCardio(data) {
      return data.type is string
        && data.date is timestamp
        && data.durationS is number
        && data.durationS > 0
        && data.durationS <= 86400
        && optionalNumber(data, 'distanceKm')
        && optionalNumber(data, 'calories')
        && optionalNumber(data, 'avgHeartRate')
        && optionalNumber(data, 'incline')
        && (!('note' in data) || (data.note is string && data.note.size() <= 500));
    }

    // Updates write only name, length, days and updatedAt; origin stays as
    // stored and is checked on the result.
    function isProgram(data) {
      return data.name is string
        && data.name.size() >= 1
        && data.name.size() <= 60
        && data.days is list
        && data.days.size() >= 1
        && data.days.size() <= 7
        && data.origin in ['own', 'catalog', 'generated'];
    }

    // A user's own data, guest or not.
    match /users/{uid} {
      allow read, write: if isOwner(uid);

      // Validated; only reachable here, the rule below excludes it.
      match /cardio/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && isCardio(request.resource.data);
      }

      // Validated; only reachable here, the rule below excludes it.
      match /programs/{id} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && isProgram(request.resource.data);
      }

      // Every other subcollection, at any depth, as before.
      match /{collection}/{document=**} {
        allow read, write: if isOwner(uid)
          && !(collection in ['cardio', 'programs']);
      }
    }

    match /exercises/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /programs/{programId} {
      allow read: if signedIn();
      allow write: if isAdmin();

      match /detail/{doc} {
        allow read: if isAdmin()
          || (signedIn()
            && (isFree(get(/databases/$(database)/documents/programs/$(programId)))
              || hasEntitlement()));
        allow write: if isAdmin();
      }
    }

    // Written only by the RevenueCat webhook through the Admin SDK.
    match /entitlements/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
    }
  }
}
